server {
    listen 80;
    server_name _;

    # Cluster DNS resolver. NGINX_RESOLVER is populated at container start by
    # /docker-entrypoint.d/10-extract-resolver.envsh from /etc/resolv.conf.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API + SSE to backend.
    # Using a variable in proxy_pass forces nginx to re-resolve DNS per request
    # (subject to `resolver` TTL), so Service ClusterIP changes are picked up
    # automatically — no need to restart the frontend pod.
    location /api/ {
        set $backend_upstream "${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_pass         http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # SSE / streaming support
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
        chunked_transfer_encoding on;
    }
}
